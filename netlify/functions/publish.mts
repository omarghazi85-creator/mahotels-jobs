import { getStore } from '@netlify/blobs';
const env=(k:string)=>Netlify.env.get(k)||'';
// Confirmed from MAHotels WordPress taxonomy via Jetpack (2026-11-16).
const countryIds:Record<string,number>={'Saudi Arabia':7473,'United Arab Emirates':7474,'Bahrain':7475,'Oman':7476,'Jordan':7477,'Egypt':7478,'Lebanon':7479,'Morocco':7480};
type Job={key:string;arabic_title:string;arabic_description:string;apply_url:string;source:string;country:string;state:'ready'|'sent';expiresAt?:string};
const esc=(s:string)=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));
const norm=(s:string)=>{try{const u=new URL(s);if(u.protocol!=='https:')return '';u.hash='';for(const k of [...u.searchParams.keys()])if(/^utm_|^oga$|^ref$/i.test(k))u.searchParams.delete(k);u.searchParams.sort();return u.toString().replace(/\/$/,'')}catch{return ''}};
export default async()=>{if(env('JOBS_EMERGENCY_STOP')!=='false'||env('ENABLE_WP_SYNC')!=='true'||env('WP_DRAFT_ONLY')!=='true'||env('WP_JOB_SCHEMA_VERIFIED')!=='true'){console.log('WP sync disabled');return}const site=env('WP_SITE_URL'),user=env('WP_USERNAME'),pass=env('WP_APP_PASSWORD'),base=env('WP_JOB_REST_BASE');if(!/^https:\/\/[^/]+$/.test(site)||!user||!pass||!/^[-a-zA-Z0-9_]+$/.test(base))return;const endpoint=new URL('/wp-json/wp/v2/'+base,site);const auth='Basic '+btoa(user+':'+pass);const headers={Authorization:auth,Accept:'application/json'};const known=new Set<string>();let pages=0;try{for(let page=1;page<=20;page++){const url=new URL(endpoint);url.searchParams.set('per_page','100');url.searchParams.set('page',String(page));url.searchParams.set('context','edit');url.searchParams.set('status','any');const r=await fetch(url,{headers,signal:AbortSignal.timeout(20000)});if(!r.ok)throw Error('Audit '+r.status);if(page===1){pages=Number(r.headers.get('X-WP-TotalPages'));if(!Number.isInteger(pages)||pages<1||pages>20)throw Error('Incomplete pagination')}const rows:unknown=await r.json();if(!Array.isArray(rows))throw Error('Invalid audit');for(const item of rows){const html=String((item as {content?:{raw?:string;rendered?:string}}).content?.raw||(item as {content?:{rendered?:string}}).content?.rendered||'');for(const m of html.matchAll(/href\s*=\s*["']([^"']+)["']/gi)){const url=norm(m[1]);if(url)known.add(url)}}if(page>=pages)break}}catch(e){console.error('Fail-closed audit',String(e));return}const store=getStore('mahotels-jobs-v1');let created=0;for await(const {blobs} of store.list({paginate:true})){for(const {key} of blobs){if(created>=1)break;const j=await store.get(key,{type:'json'}) as Job|null;if(!j||j.state!=='ready'||(j.expiresAt&&Date.parse(j.expiresAt)<Date.now()))continue;const original=norm(j.apply_url);const countryId=countryIds[j.country];if(!original||!countryId)continue;if(known.has(original)){await store.setJSON(key,{...j,state:'sent'});continue}const slug='job-'+j.key.slice(0,24);const query=new URL(endpoint);query.searchParams.set('slug',slug);query.searchParams.set('context','edit');query.searchParams.set('status','any');const check=await fetch(query,{headers});if(!check.ok)return;const matches:unknown=await check.json();if(!Array.isArray(matches))return;if(matches.length){await store.setJSON(key,{...j,state:'sent'});continue}const content='<p>'+esc(j.arabic_description).replace(/\n\n+/g,'</p><p>')+'</p><p><a href="'+esc(j.apply_url)+'" rel="nofollow noopener noreferrer">التقديم من المصدر الأصلي</a></p>';const r=await fetch(endpoint,{method:'POST',headers:{...headers,'Content-Type':'application/json'},body:JSON.stringify({title:j.arabic_title,content,slug,status:'draft',ma_job_country:[countryId]})});if(!r.ok){console.error('Draft failed',r.status);return}const posted=await r.json();if(!posted?.id||posted.status!=='draft')return;await store.setJSON(key,{...j,state:'sent',wordpress_id:posted.id});known.add(original);created++}if(created>=1)break}console.log(JSON.stringify({drafts_created:created}))};

